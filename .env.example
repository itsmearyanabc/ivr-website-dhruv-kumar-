# =========================================================================================
# BulkShout environment variables
# =========================================================================================
# Copy to .env for local development, and set the same keys in the Render dashboard
# (Service -> Environment) for the deployed site.

# --- Supabase (required) -----------------------------------------------------------------
# Project URL and keys from Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public/anon key. Either name works; the publishable name is the current one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key. Server-side only - never expose this to the browser.
# Also used to sign the admin impersonation cookie, so changing it ends any active
# "Login as user" session.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator console (required) ----------------------------------------------------
# The only credentials accepted at /admin. Without these the admin sign-in returns
# "System configuration error".
ADMIN_EMAIL=admin@xpack.in
ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------------------

# reCAPTCHA Enterprise (score-based). All THREE are needed before anything is enforced - the
# site key alone only produces a token in the browser, and a token nobody checks is
# decoration. Until the project and API key are set, verification is skipped and the panel
# behaves exactly as it does without them.
# Site key: Google Cloud -> Security -> reCAPTCHA -> your key. Public, ships to the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# The Google Cloud project the key belongs to (the project ID, not its display name).
RECAPTCHA_PROJECT_ID=
# An API key for that project, restricted to the reCAPTCHA Enterprise API. Server-side only.
RECAPTCHA_API_KEY=
# monitor (default) assesses and logs but never blocks; enforce actually refuses. Roll out on
# monitor, read the log for a few days of real traffic, and only then switch to enforce - a
# captcha that is wrong about real customers turns them away without ever telling you.
RECAPTCHA_MODE=monitor

# Google sign-in. Set to 1 only AFTER the Google provider is enabled in
# Supabase -> Authentication -> Providers, with a Google Cloud OAuth client ID and secret, and
# https://<your domain>/auth/callback listed as an authorised redirect URI in both places.
# Whether Google works is decided there, not here - so a button turned on before that is
# configured only ever produces an error.
NEXT_PUBLIC_GOOGLE_AUTH=0
# Salt for hashing submitter IPs on wallet top-up attempts. Falls back to the service role
# key when unset.
IP_HASH_SALT=

# BharatPe / generic UPI gateway credentials. Only needed if a payment method is switched to
# GENERIC_UPI verification in Admin -> Payments -> Payment methods. The mode refuses to save
# while any of the three is unset, so a half-configured gateway cannot be selected.
# UPI_GATEWAY_URL is the endpoint the UTR is POSTed to as
# {"merchant_id": ..., "token": ..., "utr": ...}.
UPI_GATEWAY_URL=
UPI_GATEWAY_MERCHANT_ID=
UPI_GATEWAY_TOKEN=

# Decentro bank-lookup credentials. Only needed if a payment method is switched from MANUAL
# to DECENTRO verification in Admin -> Payments -> Payment methods.
DECENTRO_BASE_URL=
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_MODULE_SECRET=
DECENTRO_PROVIDER_SECRET=
DECENTRO_ACCOUNT_NUMBER=
DECENTRO_STATEMENT_PATH=

# The public origin. On the VPS this is the real domain, and it must also be allowlisted
# under Supabase -> Authentication -> URL Configuration, or the magic-link fallback that
# "Login as user" relies on will fail silently.
# APP_URL=https://bulkshout.com
APP_URL=http://localhost:3000
